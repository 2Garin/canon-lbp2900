<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name>Canon LBP2900 (Docker CUPS)</name>

  <service>
    <type>_ipp._tcp</type>
    <port>@IPP_PORT@</port>

    <txt-record>txtvers=1</txt-record>
    <txt-record>qtotal=1</txt-record>
    <txt-record>rp=printers/Canon_LBP2900</txt-record>
    <txt-record>ty=Canon LBP2900</txt-record>
    <txt-record>product=(Canon LBP2900)</txt-record>
    <txt-record>pdl=application/pdf,image/pwg-raster,image/urf</txt-record>
    <txt-record>Color=F</txt-record>
    <txt-record>Duplex=F</txt-record>
    <txt-record>note=Canon LBP2900 via Docker CUPS</txt-record>
    <txt-record>adminurl=http://@NAS_IP@:@IPP_PORT@/printers/Canon_LBP2900</txt-record>
  </service>
</service-group>
