# CUPS runtime: track only directory placeholders (never jobs or TLS keys)
/cups-persistent/*
!/cups-persistent/.gitkeep
/data/*
!/data/.gitkeep
/cups/
/captdriver-master/
/captdriver.zip
/windows-install.txt
/avahi/*.backup
/avahi/*.disabled
.env
.env.*
!.env.example
/compose.override.yaml
/docker-compose.override.yml
*.key
*.pem
*.p12
*.pfx
*.log
*.tmp
*.swp
*.bak
*.backup
*.orig
*~
.DS_Store
.idea/
.vscode/
